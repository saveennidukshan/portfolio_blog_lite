<%- include('../partials/header') %>

<article class="single-article">
  <!-- Top Navigation / Breadcrumbs -->
  <div class="article-breadcrumb">
    <a href="/" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to all articles</span>
    </a>
  </div>

  <!-- Article Header -->
  <header class="single-article-header">
    <div class="article-meta-top">
      <time datetime="<%= post.created_at %>" class="article-date">
        <%= new Date(post.created_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
      </time>
      <span class="meta-dot">&bull;</span>
      <span class="article-reading-time"><%= post.reading_time || '3 min read' %></span>
    </div>

    <% if (typeof isPreview !== 'undefined' && isPreview) { %>
      <div style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 700; color: #92400e; background: #fef3c7; border: 1px solid #fde68a; padding: 0.2rem 0.6rem; border-radius: 9999px; margin-bottom: 0.75rem;">
        <span>Draft Preview (Only Visible to Admin)</span>
      </div>
    <% } %>

    <h1 class="single-article-title"><%= post.title %></h1>

    <% if (post.tagList && post.tagList.length > 0) { %>
      <div class="article-tags-wrap">
        <% post.tagList.forEach(t => { %>
          <span class="article-tag">#<%= t %></span>
        <% }); %>
      </div>
    <% } %>

    <!-- Author Byline -->
    <div class="author-byline">
      <div class="byline-avatar"><%= author.avatarInitials %></div>
      <div class="byline-info">
        <span class="byline-name"><%= author.name %></span>
        <span class="byline-title"><%= author.title %></span>
      </div>
      <div class="byline-actions">
        <button type="button" class="btn btn-sm btn-outline copy-link-btn" id="copyLinkBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span id="copyLinkText">Share</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Article Prose Content -->
  <div class="article-content prose">
    <%- post.htmlContent %>
  </div>

  <!-- More Articles Navigation -->
  <% if (typeof morePosts !== 'undefined' && morePosts && morePosts.length > 0) { %>
    <section class="more-articles-section">
      <div class="more-header">
        <h3 class="more-title">More from the blog</h3>
        <a href="/" class="more-view-all">View all &rarr;</a>
      </div>

      <div class="more-grid">
        <% morePosts.forEach(otherPost => { %>
          <a href="/blog/<%= otherPost.slug %>" class="more-card">
            <time class="more-date"><%= new Date(otherPost.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
            <h4 class="more-card-title"><%= otherPost.title %></h4>
            <span class="more-read-time"><%= otherPost.reading_time || '3 min read' %></span>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
</article>

<%- include('../partials/footer') %>
