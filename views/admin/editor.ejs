<%- include('../partials/admin-header', { currentTab: mode === 'create' ? 'new' : '' }) %>

<div class="admin-editor-container">

  <!-- Editor Header Navigation -->
  <div class="editor-head">
    <div class="editor-breadcrumb">
      <a href="/admin" class="editor-back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Dashboard
      </a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current"><%= mode === 'create' ? 'Write New Article' : 'Edit Article' %></span>
    </div>

    <div class="editor-mode-toggle">
      <button type="button" class="mode-btn active" id="tabWrite">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Write
      </button>
      <button type="button" class="mode-btn" id="tabPreview">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        Live Preview
      </button>
    </div>
  </div>

  <form action="<%= mode === 'create' ? '/admin/posts/new' : '/admin/posts/' + post.id + '/edit' %>" method="POST" id="articleForm" class="editor-form">
    <!-- CSRF Protection Token -->
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="editor-layout">

      <!-- Left Column: Writing Canvas -->
      <div class="editor-canvas">

        <!-- Title Input -->
        <div class="canvas-field">
          <input
            type="text"
            id="postTitle"
            name="title"
            class="title-input"
            placeholder="Article Title..."
            value="<%= post.title %>"
            autocomplete="off"
            required
            autofocus
          />
        </div>

        <!-- Slug URL Preview & Override -->
        <div class="slug-field-wrap">
          <span class="slug-prefix">Permalink: /blog/</span>
          <input
            type="text"
            id="postSlug"
            name="slug"
            class="slug-input"
            placeholder="custom-slug"
            value="<%= post.slug %>"
            autocomplete="off"
          />
          <button type="button" id="autoSlugBtn" class="slug-auto-btn" title="Regenerate slug from title">Auto</button>
        </div>

        <!-- Markdown Formatting Toolbar -->
        <div class="markdown-toolbar" id="markdownToolbar">
          <button type="button" class="tool-btn" data-tool="bold" title="Bold (Ctrl+B)"><b>B</b></button>
          <button type="button" class="tool-btn" data-tool="italic" title="Italic (Ctrl+I)"><i>I</i></button>
          <div class="tool-separator"></div>
          <button type="button" class="tool-btn" data-tool="h2" title="Heading 2">H2</button>
          <button type="button" class="tool-btn" data-tool="h3" title="Heading 3">H3</button>
          <div class="tool-separator"></div>
          <button type="button" class="tool-btn" data-tool="quote" title="Blockquote">&ldquo;&rdquo;</button>
          <button type="button" class="tool-btn" data-tool="code" title="Inline Code"><code>&lt;&gt;</code></button>
          <button type="button" class="tool-btn" data-tool="codeblock" title="Code Block"><code>```{ }</code></button>
          <button type="button" class="tool-btn" data-tool="list" title="Bulleted List">&bull; List</button>
          <button type="button" class="tool-btn" data-tool="link" title="Link">[Link]</button>
        </div>

        <!-- Markdown Content Textarea (Write Mode) -->
        <div class="editor-textarea-wrap" id="writePane">
          <textarea
            id="postContent"
            name="content"
            class="content-textarea"
            placeholder="Write your article in Markdown... Supports headings, code blocks, lists, quotes, and links."
            rows="22"
            required
          ><%= post.content %></textarea>

          <div class="editor-metrics-bar">
            <span id="wordCount">0 words</span>
            <span class="metrics-dot">&bull;</span>
            <span id="readTime">1 min read</span>
            <span class="metrics-dot">&bull;</span>
            <span class="markdown-supported-badge">Markdown Enabled</span>
          </div>
        </div>

        <!-- Live Preview Pane (Preview Mode) -->
        <div class="preview-pane" id="previewPane" style="display: none;">
          <div class="preview-header">
            <span class="preview-badge">Live Reader Preview</span>
            <h1 class="preview-title" id="previewTitle">Untitled Article</h1>
          </div>
          <div class="preview-prose prose" id="previewContent">
            <p class="preview-placeholder">Your rendered markdown will appear here...</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Publishing Sidebar Settings -->
      <aside class="editor-sidebar">

        <div class="sidebar-card">
          <h3 class="sidebar-card-title">Publishing Settings</h3>

          <!-- Excerpt Field -->
          <div class="sidebar-field">
            <label for="postExcerpt" class="sidebar-label">
              Short Excerpt / Summary
            </label>
            <textarea
              id="postExcerpt"
              name="excerpt"
              class="sidebar-textarea"
              rows="3"
              placeholder="A brief 1-2 sentence description shown in blog feeds..."
            ><%= post.excerpt %></textarea>
          </div>

          <!-- Tags Field -->
          <div class="sidebar-field">
            <label for="postTags" class="sidebar-label">
              Tags
            </label>
            <input
              type="text"
              id="postTags"
              name="tags"
              class="sidebar-input"
              placeholder="e.g. Express, Node.js, Architecture"
              value="<%= post.tags %>"
            />
            <span class="sidebar-hint">Separate multiple tags with commas</span>
          </div>

          <!-- Publish State Toggle -->
          <div class="sidebar-field publish-toggle-wrap">
            <label class="toggle-control">
              <input
                type="checkbox"
                id="postPublished"
                name="published"
                value="1"
                class="toggle-checkbox"
                <%= post.published === 1 ? 'checked' : '' %>
              />
              <span class="toggle-slider"></span>
              <span class="toggle-label-text" id="publishStatusText">
                <%= post.published === 1 ? 'Status: Published' : 'Status: Draft' %>
              </span>
            </label>
            <span class="sidebar-hint">Drafts are only visible to you in the admin portal</span>
          </div>

          <!-- Action Buttons -->
          <div class="sidebar-actions">
            <button type="submit" class="btn btn-primary btn-full save-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span><%= mode === 'create' ? 'Save &amp; Publish' : 'Update Article' %></span>
            </button>

            <a href="/admin" class="btn btn-outline btn-full">Cancel</a>
          </div>

        </div>

      </aside>

    </div>
  </form>

</div>

<%- include('../partials/admin-footer') %>
